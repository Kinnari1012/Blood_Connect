# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.ct4eu4j.mongodb.net/?appName=Cluster0

# JWT Authentication
JWT_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security & Password Hashing
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Business Logic Settings
ELIGIBILITY_GAP_DAYS=90
MAX_DONOR_NOTIFY_COUNT=10
